{
  "version": 2,
  "builds": [
    {
      "src": "backend/app.py",
      "use": "@vercel/python"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "style.css",
      "use": "@vercel/static"
    },
    {
      "src": "java.js",
      "use": "@vercel/static"
    },
    {
      "src": "bg.jpg",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/app.py"
    },
    {
      "src": "/style.css",
      "dest": "/style.css"
    },
    {
      "src": "/java.js",
      "dest": "/java.js"
    },
    {
      "src": "/bg.jpg",
      "dest": "/bg.jpg"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}